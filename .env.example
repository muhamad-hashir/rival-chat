# Copy this file to .env.local and fill in your Firebase web app config.
# Copy values from Firebase Console → Project Settings → Your apps → Config
# These values are public client-side config (API key is NOT a secret).
# Protect your data with Firebase Authentication + Realtime Database Rules.

VITE_FIREBASE_API_KEY=REPLACE_WITH_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_YOUR_APP_ID
VITE_FIREBASE_DATABASE_URL=https://REPLACE_WITH_YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app
